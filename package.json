{
  "name": "n8n-nodes-dart",
  "version": "0.2.9",
  "author": {
    "name": "Dart",
    "email": "software@dartai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-dart/n8n-nodes-dart.git"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.52.4",
    "@types/node": "26.6.5",
    "cspell": "10.4.0",
    "eslint": "9.39.5",
    "n8n-workflow": "2.43.4",
    "prettier": "3.9.10",
    "release-it": "21.1.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "description": "The Dart n8n node",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://dartai.com",
  "keywords": [
    "dart",
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DartApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Dart/Dart.node.js"
    ]
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "@n8n/node-cli@0.52.4": "patches/@n8n%2Fnode-cli@0.52.4.patch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format-check": "prettier --check .",
    "format-fix": "prettier --write . --list-different",
    "lint": "n8n-node lint",
    "lint-fix": "n8n-node lint --fix",
    "spellcheck": "cspell '**' --no-progress",
    "release": "n8n-node release",
    "req-up-all": "bun update --latest --interactive",
    "prepublishOnly": "n8n-node prerelease",
    "make-api": "./admin/make-api.sh"
  }
}
